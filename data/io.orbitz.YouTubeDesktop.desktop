[Desktop Entry]
Type=Application
Name=YouTube API Player - By Orbitz
Name[en_US]=YouTube API Player - By Orbitz
Name[pt_BR]=YouTube API Player - By Orbitz
Comment=A compact YouTube search and playback app
Comment[pt_BR]=Um mini app para buscar e assistir vídeos do YouTube
Exec=orbitz-youtube-wrapper
Icon=io.orbitz.YouTubeDesktop
Terminal=false
Categories=AudioVideo;Video;
StartupNotify=true

Actions=new-window;

[Desktop Action new-window]
Name=New Window
Name[pt_BR]=Nova janela
Exec=orbitz-youtube-wrapper --new-window
